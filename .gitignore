# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Trained models / recorded data (regenerate with record_gestures.py + train_gestures.py)
*.npz
*.pth

# KiCad — editor local-history + backups + autosave, not source
kicad/.history/
*-backups/
