*.kicad_pcb-bak
_autosave-*
fp-info-cache

node_modules/
package-lock.json
~$*

# KiCad build artefacts we regenerate from the scripts
board/**/*.kicad_prl
board/**/fp-info-cache

# PlatformIO build output
firmware/**/.pio/

# FreeCAD backups / caches
*.FCBak
